AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# API na Nuvem (OpenAI-compatible: Gemini, Groq, OpenRouter, OpenAI)
CLOUD_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
CLOUD_MODEL=gemini-2.5-flash
CLOUD_API_KEY=

HERMES_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_MODEL=hermes-agent
HERMES_KEY=

DISCORD_WEBHOOK_URL=

# Voz (STT Whisper + TTS Fish Audio)
WHISPER_MODEL=base
TTS_ENABLED=1
TTS_VOLUME=70
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s1

# Skin ativa e tema de cores da interface
USER_NAME=
ACTIVE_SKIN=padrao
UI_THEME=gothic
PARTICLES_ENABLED=1
SPRITE_SCALE=100
LOL_ENABLED=1
